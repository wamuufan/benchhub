export global Theme {
    // Color Palette (Dark Theme)
    in property <color> bg-dark: #121417;
    in property <color> surface: #1a1d21;
    in property <color> surface-hover: #22272b;
    in property <color> border: #2e343b;
    in property <color> primary: #3b82f6;
    in property <color> primary-hover: #2563eb;
    in property <color> success: #10b981;
    in property <color> warning: #f59e0b;
    in property <color> danger: #ef4444;
    in property <color> text-main: #f3f4f6;
    in property <color> text-muted: #9ca3af;

    // Standard Spacing Scale
    in property <length> space-xs: 4px;
    in property <length> space-sm: 8px;
    in property <length> space-md: 12px;
    in property <length> space-lg: 16px;
    in property <length> space-xl: 24px;

    // Standard Radii
    in property <length> radius-sm: 4px;
    in property <length> radius-md: 8px;
    in property <length> radius-full: 9999px;

    // Table Column Widths (History & Logs)
    in property <length> col-checkbox: 40px;
    in property <length> col-benchmark: 240px;
    in property <length> col-gpu-mode: 110px;
    in property <length> col-score: 95px;
    in property <length> col-duration: 80px;
    in property <length> col-cpu: 220px;
    in property <length> col-gpu-stat: 160px;
    in property <length> col-power: 170px;
    in property <length> col-date: 120px;
    in property <length> col-actions: 130px;

}

