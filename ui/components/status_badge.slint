import { Theme } from "../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <string> status: "success"; // "success", "warning", "danger", "muted"
    in property <length> badge_height: 28px;

    height: root.badge_height;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    horizontal-stretch: 0; // Prevent stretching!

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: status == "success" ? Theme.success :
                            status == "warning" ? Theme.warning :
                            status == "danger" ? Theme.danger : Theme.text-muted;
            }
        }

        Text {
            text: root.text;
            font-size: root.badge_height >= 28px ? 12px : 11px;
            font-weight: 600;
            color: status == "success" ? Theme.success :
                   status == "warning" ? Theme.warning :
                   status == "danger" ? Theme.danger : Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

