                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("ram", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 85px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("date", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 80px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("actions", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
    
                                // ==========================================
                                // VERİ SATIRLARI (DATA ROWS)
                                // ==========================================
                                for item in root.history: Row {
                                    // 1. Checkbox & Expand Chevron
                                    Rectangle {
                                        width: 48px;
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.2) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                if item.is_methodology && item.has_children: Rectangle {
                                                    width: 16px;
                                                    height: 22px;
                                                    arrow_touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.toggle_methodology_expand(item.id); }
                                                    }
                                                    Text {
                                                        text: item.is_expanded ? "v" : ">";
                                                        font-size: 11px;
                                                        font-weight: 800;
                                                        color: arrow_touch.has_hover ? #c4b5fd : Theme.text-muted;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if !item.is_methodology || !item.has_children: Rectangle {
                                                    width: 16px;
                                                    height: 22px;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    CheckBox {
                                                        checked: item.selected;
                                                        toggled => { root.toggle_history_selection(item.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 2. Benchmark & Preset
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            padding-left: item.is_child ? 20px : 8px;
                                            padding-right: 4px;
                                            alignment: center;
                                            spacing: 2px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Text {
                                                    text: (item.is_child ? "↳ " : "") + item.benchmark_id;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: Theme.text-main;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                if item.is_methodology: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        border-radius: 3px;
                                                        background: #8b5cf6.darker(0.5);
                                                        border-width: 1px;
                                                        border-color: #8b5cf6;
                                                        height: 16px;
                                                        HorizontalLayout {
                                                            padding-left: 4px;
                                                            padding-right: 4px;
                                                            alignment: center;
                                                            Text {
                                                                text: Lang.t("methodology_badge", Lang.current);
                                                                font-size: 9px;
                                                                font-weight: 800;
                                                                color: #c4b5fd;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if !item.is_methodology && item.preset_or_version != "": Text {
                                                text: item.preset_or_version;
                                                font-size: 11px;
                                                color: Theme.text-muted;
                                                overflow: elide;
                                                horizontal-alignment: left;
                                            }
                                        }
                                    }
    
                                    // 3. GPU Modu
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        Text { text: item.gpu_mode; font-size: 12px; color: Theme.text-main; horizontal-alignment: center; vertical-alignment: center; }
                                    }
    
                                    // 4. Skor
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        Text { text: item.score; font-size: 14px; font-weight: 700; color: Theme.success; horizontal-alignment: center; vertical-alignment: center; }
                                    }
    
                                    // 5. Süre
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        Text { text: item.duration; font-size: 12px; color: Theme.text-main; horizontal-alignment: center; vertical-alignment: center; }
                                    }
    
                                    // 6. CPU Yük
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_cpu_usage; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.cpu_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 7. CPU Sıcaklık
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_cpu_temp; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.cpu_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 8. CPU Hız
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_cpu_freq_mhz; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.cpu_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 9. GPU Yük
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_gpu_usage; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.gpu_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 10. GPU Sıcaklık
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_gpu_temp; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.gpu_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 11. Güç
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_power_w; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.power_ram_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 12. RAM
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: item.avg_ram_gb; font-size: 12px; font-weight: 600; color: Theme.text-main; horizontal-alignment: center; }
                                            Text { text: item.power_ram_peak_line; font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        }
                                    }
    
                                    // 13. Tarih
                                    Rectangle {
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        Text { text: item.date; font-size: 11px; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
    
                                    // 14. İşlem
                                    Rectangle {
                                        width: 80px;
                                        height: 44px;
                                        background: item.selected ? Theme.primary.darker(0.6) : (item.is_child ? Theme.surface.darker(0.15) : Theme.surface);
                                        VerticalLayout {
                                            alignment: center;
                                            padding-left: 6px;
                                            padding-right: 6px;
    
                                            AppButton {
                                                text: Lang.t("details", Lang.current);
                                                variant: "secondary";
                                                button_height: 28px;
                                                clicked => { root.show_run_details(item.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
}
