import { TabWidget, ListView, Button, ComboBox, ScrollView, LineEdit, CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppButton } from "app_button.slint";
import { StatusBadge } from "status_badge.slint";
import { SurfaceCard } from "surface_card.slint";
import { SettingRow } from "setting_row.slint";
import { SkeletonBlock, SkeletonSettingRow, SkeletonStorageRow, SkeletonRunnerRow, SkeletonTerminalLines } from "skeleton.slint";
import { Lang, BenchmarkItem, HistoryItem, CompareRunColumn } from "../types.slint";

export component HistoryTab inherits VerticalLayout {
    in-out property <int> selected_history_count;
    callback open_comparison_modal();
    callback filter_history_sort(string);
    in-out property <string> selected_history_status;
    in-out property <string> selected_history_gpu_mode;
    in-out property <string> selected_history_sort;
    in-out property <int> active_tab;
    callback filter_history_category(string);
    in-out property <string> history_search_query;
    in-out property <string> selected_history_category;
    in-out property <[string]> history_statuses;
    in-out property <[string]> history_sort_options;
    callback filter_history_gpu_mode(string);
    callback open_logs_dir();
    in-out property <[string]> history_gpu_modes;
    callback filter_history_search(string);
    callback show_run_details(int);
    callback export_history_csv();
    in-out property <[string]> history_categories;
    callback toggle_history_selection(int);
    callback filter_history_status(string);
    in-out property <bool> tab2_ready;
    in-out property <[HistoryItem]> history;
    in-out property <bool> can_create_methodology: false;
    callback create_methodology();
    callback toggle_methodology_expand(int);

    VerticalLayout {
                    visible: root.active_tab == 2;
                    spacing: Theme.space-md;
    
                        // Filtre ve Aksiyon Barı
                        HorizontalLayout {
                            spacing: Theme.space-sm;
    
                            LineEdit {
                                placeholder-text: Lang.t("search_placeholder", Lang.current);
                                text <=> root.history_search_query;
                                edited(query) => { root.filter_history_search(query); }
                                horizontal-stretch: 1;
                                height: 32px;
                            }
    
                            ComboBox {
                                width: 12%;
                                height: 32px;
                                model: root.history_categories;
                                current-value: root.selected_history_category;
                                selected(val) => { root.filter_history_category(val); }
                            }
    
                            ComboBox {
                                width: 11%;
                                height: 32px;
                                model: root.history_gpu_modes;
                                current-value: root.selected_history_gpu_mode;
                                selected(val) => { root.filter_history_gpu_mode(val); }
                            }
    
                            ComboBox {
                                width: 10%;
                                height: 32px;
                                model: root.history_statuses;
                                current-value: root.selected_history_status;
                                selected(val) => { root.filter_history_status(val); }
                            }
    
                            ComboBox {
                                width: 16%;
                                height: 32px;
                                model: root.history_sort_options;
                                current-value: root.selected_history_sort;
                                selected(val) => { root.filter_history_sort(val); }
                            }
    
                            if root.selected_history_count >= 2: AppButton {
                                text: Lang.t("compare", Lang.current) + " (" + root.selected_history_count + ")";
                                variant: "primary";
                                button_height: 32px;
                                clicked => { root.open_comparison_modal(); }
                            }

                            if root.selected_history_count >= 2 && root.can_create_methodology: AppButton {
                                text: Lang.t("create_methodology", Lang.current) + " (" + root.selected_history_count + ")";
                                variant: "secondary";
                                button_height: 32px;
                                clicked => { root.create_methodology(); }
                            }
    
                            AppButton {
                                text: Lang.t("export_csv", Lang.current);
                                variant: "secondary";
                                button_height: 32px;
                                clicked => { root.export_history_csv(); }
                            }
    
                            AppButton {
                                text: Lang.t("open_log_dir", Lang.current);
                                variant: "secondary";
                                button_height: 32px;
                                clicked => { root.open_logs_dir(); }
                            }
                        }
    
                        // Tablo Alanı (Sabit Kutu)
                        Rectangle {
                            vertical-stretch: 1;
    
                            if !root.tab2_ready: ScrollView {
                                GridLayout {
                                    width: 100%;
                                    spacing-horizontal: 0px;
                                    spacing-vertical: 2px;
    
                                    // BAŞLIK SATIRI (HEADER ROW)
                                    Row {
                                        Rectangle {
                                            width: 48px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: "#"; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 3;
                                            min-width: 130px;
                                            height: 36px;
                                            background: Theme.surface;
                                            HorizontalLayout { padding-left: 8px; Text { text: Lang.t("benchmark", Lang.current); font-weight: 700; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 90px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("gpu_mode", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 75px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("score", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            min-width: 55px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("duration", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 75px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("cpu_load", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 85px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("cpu_temp", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 80px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("cpu_freq", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 75px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("gpu_load", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 85px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("gpu_temp", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 80px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("power", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
