                                            horizontal-stretch: 2;
                                            min-width: 75px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("ram", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 2;
                                            min-width: 85px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("date", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            width: 80px;
                                            height: 36px;
                                            background: Theme.surface;
                                            Text { text: Lang.t("actions", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
    
                                    // Row 1 Skeleton
                                    Row {
                                        Rectangle { width: 48px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 16px; height: 16px; } } } }
                                        Rectangle { horizontal-stretch: 3; min-width: 130px; height: 44px; background: Theme.surface; VerticalLayout { padding-left: 8px; alignment: center; spacing: 4px; HorizontalLayout { alignment: start; SkeletonBlock { width: 130px; height: 13px; } } HorizontalLayout { alignment: start; SkeletonBlock { width: 70px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 90px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 70px; height: 20px; border-radius: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 55px; height: 16px; } } } }
                                        Rectangle { horizontal-stretch: 1; min-width: 55px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 38px; height: 12px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 40px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 48px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 42px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 45px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 52px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 40px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 48px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 42px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 46px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 54px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 44px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 68px; height: 12px; } } } }
                                        Rectangle { width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 68px; height: 28px; } } } }
                                    }
    
                                    // Row 2 Skeleton
                                    Row {
                                        Rectangle { width: 48px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 16px; height: 16px; } } } }
                                        Rectangle { horizontal-stretch: 3; min-width: 130px; height: 44px; background: Theme.surface; VerticalLayout { padding-left: 8px; alignment: center; spacing: 4px; HorizontalLayout { alignment: start; SkeletonBlock { width: 110px; height: 13px; } } HorizontalLayout { alignment: start; SkeletonBlock { width: 60px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 90px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 70px; height: 20px; border-radius: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 55px; height: 16px; } } } }
                                        Rectangle { horizontal-stretch: 1; min-width: 55px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 38px; height: 12px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 40px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 48px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 42px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 45px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 52px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 40px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 48px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 42px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 46px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 54px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 44px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 68px; height: 12px; } } } }
                                        Rectangle { width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 68px; height: 28px; } } } }
                                    }
    
                                    // Row 3 Skeleton
                                    Row {
                                        Rectangle { width: 48px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 16px; height: 16px; } } } }
                                        Rectangle { horizontal-stretch: 3; min-width: 130px; height: 44px; background: Theme.surface; VerticalLayout { padding-left: 8px; alignment: center; spacing: 4px; HorizontalLayout { alignment: start; SkeletonBlock { width: 140px; height: 13px; } } HorizontalLayout { alignment: start; SkeletonBlock { width: 80px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 90px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 70px; height: 20px; border-radius: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 55px; height: 16px; } } } }
                                        Rectangle { horizontal-stretch: 1; min-width: 55px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 38px; height: 12px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 40px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 48px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 42px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 45px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 52px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 40px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 48px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 42px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 46px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 54px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 75px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; spacing: 4px; HorizontalLayout { alignment: center; SkeletonBlock { width: 44px; height: 10px; } } HorizontalLayout { alignment: center; SkeletonBlock { width: 50px; height: 10px; } } } }
                                        Rectangle { horizontal-stretch: 2; min-width: 85px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 68px; height: 12px; } } } }
                                        Rectangle { width: 80px; height: 44px; background: Theme.surface; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; SkeletonBlock { width: 68px; height: 28px; } } } }
                                    }
                                }
                            }
    
                            if root.tab2_ready: ScrollView {
                                GridLayout {
                                    width: 100%;
                                    spacing-horizontal: 0px;
                                    spacing-vertical: 2px;
    
                                // ==========================================
                                // BAŞLIK SATIRI (HEADER ROW)
                                // ==========================================
                                Row {
                                    Rectangle {
                                        width: 48px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: "#"; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 3;
                                        min-width: 130px;
                                        height: 36px;
                                        background: Theme.surface;
                                        HorizontalLayout { padding-left: 8px; Text { text: Lang.t("benchmark", Lang.current); font-weight: 700; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; } }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 90px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("gpu_mode", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 75px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("score", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 55px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("duration", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 75px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("cpu_load", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 85px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("cpu_temp", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 80px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("cpu_freq", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 75px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("gpu_load", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 85px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("gpu_temp", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-width: 80px;
                                        height: 36px;
                                        background: Theme.surface;
                                        Text { text: Lang.t("power", Lang.current); font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle {
