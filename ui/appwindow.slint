                        // GPU Frekans Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("gpu_freq_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.gpu_freq; font-size: 12px; font-weight: 700; color: #818cf8; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GPU VRAM Frekans Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("vram_freq_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.vram_freq; font-size: 12px; font-weight: 700; color: #818cf8; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GPU Güç Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("gpu_power_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.gpu_power; font-size: 12px; font-weight: 700; color: #34d399; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GPU Throttling Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("gpu_throttling_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        border-radius: Theme.radius-sm;
                                        border-width: col.has_gpu_throttling ? 1.5px : 0px;
                                        border-color: col.has_gpu_throttling ? (col.gpu_throttling == "Güç Limiti" ? Theme.warning : Theme.danger) : transparent;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.gpu_throttling; font-size: 11px; font-weight: 700; color: Theme.text-main; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GRUP 3: 🧠 BELLEK METRİKLERİ
                        Text { text: Lang.t("memory_metrics_group", Lang.current); font-size: 11px; font-weight: 700; color: #a855f7; }

                        // Sistem RAM Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("ram_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.ram; font-size: 12px; font-weight: 700; color: #38bdf8; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GPU VRAM Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("vram_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.vram; font-size: 12px; font-weight: 700; color: #c084fc; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GRUP 4: 📦 SÜRE VE AC GÜÇ METRİKLERİ
                        Text { text: Lang.t("other_metrics_group", Lang.current); font-size: 11px; font-weight: 700; color: Theme.text-main; }

                        // Süre Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("duration_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.duration; font-size: 12px; font-weight: 700; color: Theme.text-main; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // GPU Modu Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("gpu_mode", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.gpu_mode; font-size: 12px; font-weight: 700; color: #38bdf8; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // Güç Profili Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("power_profile_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.power_profile != "" ? col.power_profile : Lang.t("unknown", Lang.current); font-size: 12px; font-weight: 700; color: #38bdf8; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // AC Güç Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("ac_power_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.ac_power; font-size: 12px; font-weight: 700; color: #34d399; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // Donanım Bilgisi Row
                        Rectangle {
                            height: 36px; background: Theme.bg-dark; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
                            HorizontalLayout {
                                HorizontalLayout {
                                    width: 190px; padding-left: 12px; padding-right: 12px;
                                    Text { text: Lang.t("system_info_row", Lang.current); font-size: 12px; color: Theme.text-muted; vertical-alignment: center; horizontal-alignment: left; }
                                }
                                for col in root.compare_runs: HorizontalLayout {
                                    horizontal-stretch: 1; min-width: 140px;
                                    Rectangle { width: 1px; background: Theme.border; }
                                    Rectangle {
                                        horizontal-stretch: 1; clip: true;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: col.system_info; font-size: 10px; color: Theme.text-muted; overflow: elide; vertical-alignment: center; horizontal-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. Footer Divider
                Rectangle { height: 1px; background: Theme.border; }

                // 5. Footer: Sol tarafta özet metin, Sağ tarafta PNG Kaydet ve Kapat butonları
                HorizontalLayout {
                    spacing: Theme.space-sm;

                    Text {
                        text: Lang.t("compare_summary_prefix", Lang.current) + " " + root.compare_runs.length + " " + Lang.t("compare_summary_suffix", Lang.current);
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-muted;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    AppButton {
                        text: Lang.t("export_png", Lang.current);
                        variant: "primary";
                        button_height: 32px;
                        clicked => { root.export_comparison_image(); }
                    }

                    AppButton {
                        text: Lang.t("close", Lang.current);
                        variant: "secondary";
                        button_height: 32px;
                        clicked => { root.close_compare_dialog(); }
                    }
                }
            }
        }
    }
}
