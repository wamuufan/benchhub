                                    VerticalLayout { padding: 4px; alignment: center; spacing: 2px;
                                        Text { text: Lang.t("cpu_avg_power", Lang.current); font-size: 10px; color: Theme.text-muted; horizontal-alignment: center; }
                                        Text { text: root.details_avg_power_w; font-size: 13px; font-weight: 700; color: #34d399; horizontal-alignment: center; }
