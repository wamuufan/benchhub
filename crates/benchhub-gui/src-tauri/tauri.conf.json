{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BenchHub",
  "version": "0.1.0",
  "identifier": "com.benchhub.app",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "BenchHub",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
